    JOIN files d ON d.path='actions/'||a.id||'/RESULT-'||a.id||'.json'
    WHERE NOT EXISTS(SELECT 1 FROM request_blockers b WHERE b.request=r.id AND b.revision=r.revision)
    ORDER BY a.rowid LIMIT 1
