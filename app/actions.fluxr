fn has_ref 2 items uint refid uint bool do 2 val uint i int 3
  set i 0
  while lt i call size 1 items 3
    set val call nth 2 items i
    if or call same 2 val refid call same 2 call key 2 val call str 1 utf8 "id" refid 1
    ret true
  0
    next i
  ret false

fn subset 2 selected uint items uint bool do 1 i int 3
  set i 0
  while lt i call size 1 selected 2
    if not call has_ref 2 items call nth 2 selected i 1
    ret false
  0
    next i
  ret true

