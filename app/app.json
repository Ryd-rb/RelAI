{
  "name": "RelAI",
  "modules": [
    "bindings.fluxr",
    "store.fluxr",
    "provider.fluxr",
    "queue.fluxr",
    "actions.fluxr",
    "receive.fluxr",
    "ui.fluxr",
    "graph.fluxr",
    "tools.fluxr",
    "tool_jobs.fluxr",
    "knowledge.fluxr",
    "context.fluxr",
    "panels.fluxr",
    "review.fluxr",
    "services.fluxr",
    "cache.fluxr",
    "schedules.fluxr",
    "authority.fluxr",
    "events.fluxr",
    "analysis.fluxr",
    "connectors.fluxr",
    "prerequisites.fluxr",
    "effects.fluxr",
    "files.fluxr",
    "monitoring.fluxr",
    "graph_layers.fluxr",
    "git-operations.fluxr",
    "publication.fluxr",
    "service-entries.fluxr",
    "remotes.fluxr",
    "skill_manifest.fluxr",
    "operations_panel.fluxr",
    "worktrees.fluxr",
    "passages.fluxr",
    "definitions.fluxr",
    "tool_terms.fluxr",
    "source_access.fluxr",
    "proposals.fluxr",
    "desktop_values.fluxr",
    "desktop_forms.fluxr",
    "desktop_panels.fluxr",
    "desktop_edits.fluxr",
    "desktop_events.fluxr",
    "desktop_frame.fluxr",
    "desktop_files.fluxr",
    "desktop_pages.fluxr"
  ],
  "public": [
    "open_project",
    "submit",
    "capture",
    "save_model",
    "dashboard",
    "control",
    "save_term",
    "capture_graph",
    "tool_catalog",
    "tool_run",
    "tool_propose",
    "tool_test",
    "tool_qualify",
    "tool_promote",
    "tool_retire",
    "tool_revoke",
    "dictionary",
    "skill",
    "schedule",
    "events",
    "job_details",
    "connector",
    "effect_get",
    "effect_propose",
    "effect_authorize",
    "effect_apply",
    "effect_revoke",
    "effects_recover",
    "patch_preview",
    "patch_stage",
    "patch_apply",
    "suggest_terms",
    "graph_layers",
    "git_propose",
    "git_authorize",
    "git_apply",
    "git_get",
    "git_revoke",
    "git_recover",
    "remote",
    "skill_draft",
    "worktree_propose",
    "worktree_authorize",
    "worktree_apply",
    "worktree_get",
    "worktree_revoke",
    "worktree_recover",
    "term_view",
    "source_access",
    "review_definition"
  ],
  "destinations": {
    "codex": {
      "transport": "websocket",
      "url_env": "RELAI_CODEX_URL",
      "token_file_env": "RELAI_CODEX_TOKEN_FILE"
    },
    "anthropic": {
      "transport": "https",
      "url": "https://api.anthropic.com/v1/messages",
      "headers": {
        "anthropic-version": "2023-06-01"
      },
      "key_env": "ANTHROPIC_API_KEY",
      "key_header": "x-api-key"
    },
    "qwen": {
      "transport": "https",
      "url_env": "RELAI_QWEN_CHAT_URL",
      "key_env": "RELAI_QWEN_KEY",
      "key_header": "Authorization",
      "optional_key": true
    }
  },
  "continuations": {
    "tool_run": {
      "$call": [
        "builtin_run",
        "registered_run",
        "effect_run",
        "network_run",
        "git_run",
        "remote_run",
        "worktree_run"
      ]
    },
    "tool_propose": {
      "$evaluate": [
        "guest_tool_admit"
      ]
    },
    "tool_qualify": {
      "$evaluate": [
        "guest_tool_tested"
      ]
    },
    "tool_test": {
      "$evaluate": [
        "guest_tool_tested"
      ]
    },
    "guest_tool_tested": {
      "$evaluate": [
        "guest_tool_tested"
      ]
    },
    "effect_apply": {
      "$filesystem": [
        "guest_effect_finished"
      ]
    },
    "effects_recover": {
      "$filesystem": [
        "guest_effect_reconciled"
      ]
    },
    "patch_apply": {
      "$filesystem": [
        "guest_effect_finished"
      ]
    },
    "scheduled_read": {
      "$call": [
        "builtin_run"
      ]
    },
    "builtin_run": {
      "$evaluate": [
        "guest_tool_verified"
      ],
      "$call": [
        "service_run",
        "extended_entry"
      ]
    },
    "registered_run": {
      "$evaluate": [
        "guest_tool_deliver"
      ]
    },
    "effect_run": {
      "$filesystem": [
        "guest_effect_finished"
      ]
    },
    "guest_effect_reconciled": {
      "$filesystem": [
        "guest_effect_finished"
      ]
    },
    "git_run": {
      "$git": [
        "guest_git_finished"
      ]
    },
    "git_apply": {
      "$git": [
        "guest_git_finished"
      ]
    },
    "git_recover": {
      "$git": [
        "guest_git_reconciled"
      ]
    },
    "guest_git_reconciled": {
      "$git": [
        "guest_git_finished"
      ]
    },
    "skill_draft": {
      "$call": [
        "tool_propose"
      ]
    },
    "worktree_run": {
      "$worktree": [
        "guest_worktree_finished"
      ]
    },
    "worktree_apply": {
      "$worktree": [
        "guest_worktree_finished"
      ]
    },
    "worktree_recover": {
      "$worktree": [
        "guest_worktree_reconciled"
      ]
    },
    "guest_worktree_reconciled": {
      "$worktree": [
        "guest_worktree_finished"
      ]
    },
    "extended_entry": {
      "$call": [
        "git_diff_entry"
      ]
    }
  },
  "startup_recovery": [
    {
      "page": "recovery_page",
      "apply": "effects_recover"
    },
    {
      "page": "git_pending",
      "apply": "git_recover"
    },
    {
      "page": "worktree_pending",
      "apply": "worktree_recover"
    }
  ],
  "desktop": {
    "view": "dashboard",
    "frame": "desktop_frame",
    "event": "desktop_event",
    "result": "desktop_result",
    "file": "desktop_file"
  }
}
