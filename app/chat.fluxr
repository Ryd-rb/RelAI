fn chat_attachment_details 3 state uint base uint files uint uint do 6 item uint labelval uint keyval uint expanded uint discard uint i int 7
  set i 0
  while lt i call size 1 files 4
    set item call nth 2 files i
    set labelval call cat 2 call cat 2 call ui_default 2 call key 2 item call str 1 utf8 "display_name" call str 1 utf8 "Unnamed attachment" call str 1 utf8 " · " call ui_byte_size 1 call key 2 item call str 1 utf8 "byte_length"
    set discard call ui_emit 1 call shape 2 call str 1 @text r#"{"id":"$0","kind":"label","role":"muted","label":"$1","value":"$1"}"# @build append 1 2 call arr 0 call cat 2 call cat 2 base call str 1 utf8 "/file/" call encode 1 call integer 1 i labelval
    next i
  set keyval call cat 2 base call str 1 utf8 "/record"
  set expanded call key 2 call key 2 state call str 1 utf8 "folds" keyval
  set discard call chat_fold 4 keyval call str 1 utf8 "Attachment receipts" expanded call obj 0
  if call same 2 expanded call decode 1 call str 1 utf8 "true" 1
    set discard call ui_emit 1 call shape 2 call str 1 @text r#"{"id":"$0","kind":"detail","label":"Immutable sent attachment receipts","value":"$1","lines":8}"# @build append 1 2 call arr 0 call cat 2 keyval call str 1 utf8 "/body" call ui_show 1 files
  0
  ret 0u

