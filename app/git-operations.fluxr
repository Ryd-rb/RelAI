fn current_chat_git 2 pid uint mid uint bool do 0 1
ret call same 2 call key 2 call nth 2 call query 2 call str 1 @text r#"
SELECT NOT EXISTS(SELECT 1 FROM chat_git_mutations WHERE mutation=?1) OR EXISTS(
  SELECT 1
  FROM chat_git_mutations c JOIN git_mutations m ON m.id=c.mutation
  JOIN projects p ON p.id=m.project
  JOIN requests r ON r.id=c.request AND r.project=m.project
  JOIN jobs j ON j.id=c.job AND j.project=m.project AND j.request=r.id
  WHERE m.id=?1 AND m.project=?2 AND r.state='open'
    AND r.revision=c.revision AND j.revision=c.revision
    AND j.role='discriminator' AND p.discriminator=j.session
    AND j.state NOT IN ('cancelled','superseded')) AS allowed
"# @build append 1 2 call arr 0 mid pid 0 call str 1 utf8 "allowed" call integer 1 1

pub chat_git_mutate 1 arg uint uint do 5 jobval uint prior uint requestval uint proposal uint discard uint 8
set jobval call nth 2 call query 2 call str 1 @text r#"
SELECT j.id,j.project,j.request,j.revision,j.input->>'$.arguments.tool' AS operation,
    j.input->'$.arguments.arguments' AS "arguments:json"
FROM jobs j JOIN projects p ON p.id=j.project AND p.discriminator=j.session
JOIN requests r ON r.id=j.request AND r.project=j.project AND r.revision=j.revision AND r.state='open'
WHERE j.id=? AND j.state='executing' AND j.kind='tool' AND j.role='discriminator'
  AND j.input->>'$.arguments.tool' IN ('git.stage','git.commit','git.branch')
  AND EXISTS(SELECT 1 FROM submissions s WHERE s.project=j.project AND s.request=j.request)
"# call append 2 call arr 0 call key 2 arg call str 1 utf8 "job" 0
set discard call require 2 not call same 2 jobval 0u call str 1 utf8 "The addressed chat Git job is no longer current"
set prior call nth 2 call query 2 call str 1 @text r#"
SELECT m.id AS mutation,m.digest,m.state,m.result AS "receipt:json"
FROM chat_git_mutations c JOIN git_mutations m ON m.id=c.mutation WHERE c.job=?
"# call append 2 call arr 0 call key 2 jobval call str 1 utf8 "id" 0
if not call same 2 prior 0u 1
ret call ui_default 2 call key 2 prior call str 1 utf8 "receipt" prior
0
set requestval call put 3 call put 3 call key 2 jobval call str 1 utf8 "arguments" call str 1 utf8 "project" call key 2 jobval call str 1 utf8 "project" call str 1 utf8 "operation" call key 2 jobval call str 1 utf8 "operation"
set proposal call prepare_user_git_change 1 requestval
set discard call query 2 call str 1 utf8 "INSERT INTO chat_git_mutations(mutation,job,request,revision) VALUES(?,?,?,?)" @build append 1 4 call arr 0 call key 2 proposal call str 1 utf8 "mutation" call key 2 jobval call str 1 utf8 "id" call key 2 jobval call str 1 utf8 "request" call key 2 jobval call str 1 utf8 "revision"
ret call execute_user_git_change 2 requestval proposal

