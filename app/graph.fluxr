    set discard call query 2 call str 1 utf8 "INSERT INTO inventory VALUES(?,?,?,?,?,?)" call append 2 call append 2 call append 2 call append 2 call append 2 call append 2 call arr 0 sid path dir kind hashval call key 2 entry call str 1 utf8 "size"
    if call same 2 kind call str 1 utf8 "directory" 1
