fluxr 1

fn walk 5 root uint pid uint sid uint dir uint depth int uint do 11 entries uint entry uint name uint path uint body uint info uint hashval uint kind uint countval uint discard uint i int 5
  set discard call require 2 le depth 32 call str 1 utf8 "Snapshot depth limit reached"
  set entries call fresh_read 3 root dir call str 1 utf8 "directory"
  set i 0
  while lt i call size 1 entries 4
    set entry call nth 2 entries i
    set name call key 2 entry call str 1 utf8 "name"
    if not or call same 2 call key 2 entry call str 1 utf8 "link" call decode 1 call str 1 utf8 "true" or call same 2 name call str 1 utf8 ".git" call same 2 name call str 1 utf8 "target" 6
    set path call pathjoin 2 dir name
    set kind call str 1 utf8 "directory"
    set hashval 0u
    if call same 2 call key 2 entry call str 1 utf8 "directory" call decode 1 call str 1 utf8 "false" 7
    set kind call str 1 utf8 "file"
    set countval call nth 2 call query 2 call str 1 utf8 "SELECT count(*) AS n,coalesce(sum(bytes),0) AS total FROM inventory WHERE snapshot=?" call append 2 call arr 0 sid 0
    set discard call require 2 and lt call number 1 call key 2 countval call str 1 utf8 "n" 2000 le add call number 1 call key 2 countval call str 1 utf8 "total" call number 1 call key 2 entry call str 1 utf8 "size" 8388608 call str 1 utf8 "Snapshot exceeds 2000 entries or 8 MiB"
    set body call fresh_read 3 root path call str 1 utf8 "base64"
    set info call baseinfo 1 body
    set hashval call key 2 info call str 1 utf8 "digest"
    set discard call query 2 call str 1 utf8 "INSERT OR IGNORE INTO blobs VALUES(?,?,?)" call append 2 call append 2 call append 2 call arr 0 pid hashval body
  0
    set discard call query 2 call str 1 utf8 "INSERT INTO inventory VALUES(?,?,?,?,?,?)" call append 2 call append 2 call append 2 call append 2 call append 2 call append 2 call arr 0 sid path dir kind hashval call key 2 entry call str 1 utf8 "size"
    if call same 2 kind call str 1 utf8 "directory" 1
    set discard call walk 5 root pid sid path add depth 1
  0
  0
    next i
  ret 0u

pub capture_graph 1 arg uint uint do 5 p uint pid uint sid uint nodes uint discard uint 11
  set p call project 1 arg
  set pid call key 2 p call str 1 utf8 "id"
  set nodes call observe 1 call key 2 p call str 1 utf8 "root"
  set sid call uid 0
  set discard call walk 5 call key 2 p call str 1 utf8 "root" pid sid call str 1 utf8 "" 0
  if or call same 2 nodes 0u not call same 2 nodes call observe 1 call key 2 p call str 1 utf8 "root" 5
    set nodes call uid 0
    set discard call walk 5 call key 2 p call str 1 utf8 "root" pid nodes call str 1 utf8 "" 0
    set discard call nth 2 call query 2 call str 1 utf8 "WITH changed AS (SELECT path,kind,digest,bytes FROM inventory WHERE snapshot=?1 EXCEPT SELECT path,kind,digest,bytes FROM inventory WHERE snapshot=?2), added AS (SELECT path,kind,digest,bytes FROM inventory WHERE snapshot=?2 EXCEPT SELECT path,kind,digest,bytes FROM inventory WHERE snapshot=?1) SELECT (SELECT count(*) FROM changed)+(SELECT count(*) FROM added) AS changes" call append 2 call append 2 call arr 0 sid nodes 0
    set discard call require 2 call same 2 call key 2 discard call str 1 utf8 "changes" call integer 1 0 call str 1 utf8 "Snapshot source changed during reconciliation"
    set discard call query 2 call str 1 utf8 "DELETE FROM inventory WHERE snapshot=?" call append 2 call arr 0 nodes
  0
  set nodes call query 2 call str 1 utf8 "SELECT path,parent,kind,digest,bytes FROM inventory WHERE snapshot=? ORDER BY path" call append 2 call arr 0 sid
  set discard call query 2 call str 1 utf8 "INSERT INTO snapshots VALUES(?,?,?)" call append 2 call append 2 call append 2 call arr 0 sid pid nodes
  set discard call audit 3 pid call str 1 utf8 "Snapshot captured" call shape 2 call str 1 utf8 "{\"snapshot\":\"$0\",\"entries\":\"$1\"}" call append 2 call append 2 call arr 0 sid call integer 1 call size 1 nodes
  set discard call query 2 call str 1 utf8 "INSERT INTO graph_cursors SELECT ?,coalesce(max(cursor),0) FROM events WHERE project=?" call append 2 call append 2 call arr 0 sid pid
  ret call shape 2 call str 1 utf8 "{\"snapshot\":\"$0\"}" call append 2 call arr 0 sid

fn graph_view 2 arg uint pid uint uint do 8 sid uint rowsval uint components uint node uint body uint a uint discard uint versions uint 11
  set sid call key 2 arg call str 1 @text r#"snapshot"#
  if call same 2 sid 0u 1
    set sid call key 2 call nth 2 call query 2 call str 1 @text r#"SELECT id FROM snapshots WHERE project=? ORDER BY rowid DESC LIMIT 1"# @build append 1 1 call arr 0 pid 0 call str 1 @text r#"id"#
  0
  set components call append 2 call arr 0 call shape 2 call str 1 @text r#"{"type":"button","label":"Capture snapshot","op":"capture_graph","selectResult":{"snapshot":"snapshot"},"after":{"view":"graph"},"section":"snapshot"}"# call arr 0
  if call same 2 sid 0u 1
    ret call append 2 call append 2 call arr 0 call shape 2 call str 1 @text r#"{"type":"empty","label":"Explore a retained source snapshot","text":"Capture the current project to browse files, inspect source links and compare versions without changing your working files.","section":"snapshot"}"# call arr 0 call nth 2 components 0
  0
  set rowsval call key 2 call nth 2 call query 2 call str 1 @text r#"SELECT manifest AS "nodes:json" FROM snapshots WHERE id=? AND project=?"# @build append 1 2 call arr 0 sid pid 0 call str 1 @text r#"nodes"#
  set discard call require 2 not call same 2 rowsval 0u call str 1 @text r#"Snapshot unavailable"#
  set versions call query 2 call asset 1 call str 1 utf8 "graph_snapshots.sql" @build append 1 2 call arr 0 pid sid
  set components call append 2 components call shape 2 call str 1 @text r#"{"type":"tree","nodes":"$0","navigate":{"view":"graph","snapshot":"$1"},"versions":"$2","pathField":"selected","pane":"Files","section":"source-tree"}"# @build append 1 3 call arr 0 rowsval sid versions
  set components call append 2 components call shape 2 call str 1 @text r#"{"type":"graph_layers","op":"graph_layers","snapshot":"$0","versions":"$1","pane":"Relationships","section":"relationships"}"# @build append 1 2 call arr 0 sid versions
  if call same 2 call key 2 arg call str 1 @text r#"selected"# 0u 1
    set components call append 2 components call shape 2 call str 1 @text r#"{"type":"empty","label":"Choose a file or folder","text":"Select a path above to read its captured contents. Snapshot selection never reads newer working-file bytes.","pane":"Files","section":"inspection"}"# call arr 0
  2
    set node call nth 2 call query 2 call str 1 @text r#"SELECT kind,digest,path,bytes FROM inventory WHERE snapshot=? AND path=?"# @build append 1 2 call arr 0 sid call key 2 arg call str 1 @text r#"selected"# 0
    if call same 2 node 0u 1
      set components call append 2 components call shape 2 call str 1 @text r#"{"type":"empty","label":"Path not in this snapshot","text":"Choose another captured path or switch snapshots. Your filter and zoom are retained.","pane":"Files","section":"inspection"}"# call arr 0
    2
      if call same 2 call key 2 node call str 1 @text r#"kind"# call str 1 @text r#"directory"# 3
        set a call query 2 call str 1 @text r#"SELECT path,kind,bytes,digest FROM inventory WHERE snapshot=? AND parent=? ORDER BY path"# @build append 1 2 call arr 0 sid call key 2 node call str 1 @text r#"path"#
        set components call append 2 components call shape 2 call str 1 @text r#"{"type":"card","label":"$0","text":"$1","details":"$2","pane":"Files","section":"inspection"}"# @build append 1 3 call arr 0 call key 2 node call str 1 @text r#"path"# call key 2 call nth 2 call query 2 call str 1 @text r#"SELECT printf('Folder · %d captured entries',?1) AS text"# @build append 1 1 call arr 0 call integer 1 call size 1 a 0 call str 1 @text r#"text"# call ui_merge 2 node call shape 2 call str 1 @text r#"{"snapshot":"$0"}"# @build append 1 1 call arr 0 sid
        set components call append 2 components call shape 2 call str 1 @text r#"{"type":"data","label":"Directory contents","value":"$0","pane":"Files","section":"inspection"}"# @build append 1 1 call arr 0 a
      0
      if call same 2 call key 2 node call str 1 @text r#"kind"# call str 1 @text r#"file"# 4
        set body call key 2 call nth 2 call query 2 call str 1 @text r#"SELECT content FROM blobs WHERE project=? AND digest=?"# @build append 1 2 call arr 0 pid call key 2 node call str 1 @text r#"digest"# 0 call str 1 @text r#"content"#
        set a call key 2 call baseinfo 1 body call str 1 @text r#"text"#
        if call same 2 a 0u 1
          set a call str 1 @text r#"Binary file · captured bytes are retained in this snapshot."#
        0
        set components call append 2 components call shape 2 call str 1 @text r#"{"type":"card","label":"$0","text":"$1","details":"$2","pane":"Files","section":"inspection"}"# @build append 1 3 call arr 0 call key 2 node call str 1 @text r#"path"# a call ui_merge 2 node call shape 2 call str 1 @text r#"{"snapshot":"$0"}"# @build append 1 1 call arr 0 sid
      0
  ret components
