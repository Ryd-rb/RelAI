  ret call query 2 call str 1 utf8 "SELECT e.id,e.revision,e.dictionary AS dictionary_id,d.name AS dictionary_name,e.name,e.kind,substr(e.definition,1,240) AS description FROM entries e JOIN dictionaries d ON d.id=e.dictionary AND d.archived=0 JOIN dictionary_links l ON l.dictionary=d.id AND l.enabled=1 WHERE l.project=?1 AND e.revision=(SELECT max(revision) FROM entries v WHERE v.id=e.id) AND NOT (e.kind='skill' AND e.human=0 AND EXISTS(SELECT 1 FROM skills s WHERE s.id=e.source AND s.project=e.dictionary AND s.active=0)) AND instr(unicode_fold(e.name),unicode_fold(?2))=1 ORDER BY e.name,e.dictionary,e.id LIMIT 12" call append 2 call append 2 call arr 0 pid prefix
