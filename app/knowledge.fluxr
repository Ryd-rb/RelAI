fn explicit_terms 3 pid uint body uint selected uint uint do 11 marker uint accepted uint terms uint startval uint endval uint r uint refval uint out uint discard uint i int lastpos int 6
  set discard call require 2 le call size 1 selected 128 call str 1 utf8 "Too many selected terms"
  set out call arr 0
  set i 0
  set lastpos 0
  while lt i call size 1 selected 10
    set marker call nth 2 selected i
    set startval call key 2 marker call str 1 utf8 "start"
    set endval call key 2 marker call str 1 utf8 "end"
    set discard call require 2 and le lastpos call number 1 startval lt call number 1 startval call number 1 endval call str 1 utf8 "Invalid or overlapping selected term"
    set r call key 2 marker call str 1 utf8 "ref"
    set refval call nth 2 call query 2 call str 1 utf8 "SELECT e.id,e.revision,e.name,e.kind,e.dictionary AS dictionary_id FROM entries e JOIN dictionary_links l ON l.dictionary=e.dictionary AND l.enabled=1 JOIN dictionaries d ON d.id=e.dictionary AND d.archived=0 WHERE l.project=? AND e.id=? AND e.revision=? AND e.dictionary=?" call append 2 call append 2 call append 2 call append 2 call arr 0 pid call key 2 r call str 1 utf8 "id" call key 2 r call str 1 utf8 "revision" call key 2 r call str 1 utf8 "dictionary_id" 0
    set discard call require 2 and not call same 2 refval 0u call same 2 call slice 3 body call number 1 startval call number 1 endval call key 2 refval call str 1 utf8 "name" call str 1 utf8 "Selected span or dictionary access changed"
    set out call append 2 out call shape 2 call str 1 utf8 "{\"start\":\"$0\",\"end\":\"$1\",\"ref\":\"$2\"}" call append 2 call append 2 call append 2 call arr 0 startval endval refval
    set lastpos call number 1 endval
    next i
  ret out

fn annotate_selection 3 pid uint body uint selected uint uint do 2 chosen uint automatic uint 4
  if eq 0 call size 1 selected 1
    ret call annotate 2 pid body
  0
  set chosen call explicit_terms 3 pid body selected
  set automatic call matches 2 body call vocab 1 pid
  ret call render_terms 2 body call query 2 call str 1 utf8 "WITH chosen AS (SELECT value FROM json_each(?1)), automatic AS (SELECT value FROM json_each(?2) a WHERE NOT EXISTS(SELECT 1 FROM chosen c WHERE c.value->>'start'<a.value->>'end' AND a.value->>'start'<c.value->>'end')) SELECT json_extract(value,'$.start') AS start,json_extract(value,'$.end') AS end,json_extract(value,'$.ref') AS \"ref:json\" FROM (SELECT value FROM chosen UNION ALL SELECT value FROM automatic) ORDER BY start" call append 2 call append 2 call arr 0 chosen automatic

pub suggest_terms 1 arg uint uint do 3 pid uint prefix uint discard uint 4
  set pid call key 2 call project 1 arg call str 1 utf8 "id"
  set prefix call key 2 arg call str 1 utf8 "prefix"
