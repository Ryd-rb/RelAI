fluxr 1

fn operations_panel 1 pid uint uint do 4 commands uint fsrows uint gitrows uint schedules uint 4
  set fsrows call query 2 call str 1 utf8 "SELECT id,operation,state,digest,json_extract(request,'$.path') AS path,error FROM file_effects WHERE project=? ORDER BY rowid DESC LIMIT 32" call append 2 call arr 0 pid
  set gitrows call query 2 call str 1 utf8 "SELECT id,operation,state,digest,error FROM git_mutations WHERE project=? ORDER BY rowid DESC LIMIT 32" call append 2 call arr 0 pid
  set schedules call query 2 call str 1 utf8 "SELECT id,due,period,state,revision FROM schedules WHERE project=? ORDER BY due LIMIT 32" call append 2 call arr 0 pid
  ret call shape 2 call str 1 utf8 "{\"type\":\"group\",\"label\":\"Tools and operations\",\"items\":[{\"type\":\"fold\",\"label\":\"Find and run a tool\",\"items\":[{\"type\":\"form\",\"label\":\"Find tools\",\"op\":\"tool_run\",\"fields\":[{\"name\":\"arguments\",\"label\":\"Search arguments\",\"type\":\"json\"}],\"fixed\":{\"tool\":\"tool.find\"},\"showResult\":true},{\"type\":\"form\",\"label\":\"Run tool\",\"op\":\"tool_run\",\"fields\":[{\"name\":\"tool\",\"label\":\"Tool ID\",\"type\":\"text\"},{\"name\":\"arguments\",\"label\":\"Arguments\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true},{\"type\":\"form\",\"label\":\"Run an exact registered version\",\"op\":\"tool_run\",\"fields\":[{\"name\":\"tool\",\"label\":\"Tool name\",\"type\":\"text\"},{\"name\":\"version\",\"label\":\"Version digest\",\"type\":\"text\"},{\"name\":\"arguments\",\"label\":\"Arguments\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true}]},{\"type\":\"fold\",\"label\":\"Tool versions\",\"items\":[{\"type\":\"form\",\"label\":\"Propose checked source\",\"op\":\"tool_propose\",\"fields\":[{\"name\":\"name\",\"label\":\"Name\",\"type\":\"text\"},{\"name\":\"capability\",\"label\":\"Capability ID\",\"type\":\"text\"},{\"name\":\"export\",\"label\":\"Export\",\"type\":\"text\"},{\"name\":\"source\",\"label\":\"FluxR source\",\"type\":\"textarea\"}],\"fixed\":{},\"showResult\":true},{\"type\":\"form\",\"label\":\"Test a draft\",\"op\":\"tool_test\",\"fields\":[{\"name\":\"version\",\"label\":\"Version digest\",\"type\":\"text\"},{\"name\":\"case\",\"label\":\"Test case\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true},{\"type\":\"form\",\"label\":\"Qualify a draft\",\"op\":\"tool_qualify\",\"fields\":[{\"name\":\"version\",\"label\":\"Version digest\",\"type\":\"text\"}],\"fixed\":{},\"showResult\":true},{\"type\":\"form\",\"label\":\"Promote a version\",\"op\":\"tool_promote\",\"fields\":[{\"name\":\"payload\",\"label\":\"Typed request\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true,\"jsonPayload\":\"payload\"},{\"type\":\"form\",\"label\":\"Revoke a version\",\"op\":\"tool_revoke\",\"fields\":[{\"name\":\"version\",\"label\":\"Version digest\",\"type\":\"text\"}],\"fixed\":{},\"showResult\":true}]},{\"type\":\"fold\",\"label\":\"File changes\",\"items\":[{\"type\":\"data\",\"label\":\"Recent file proposals\",\"value\":\"$0\"},{\"type\":\"form\",\"label\":\"Inspect proposal\",\"op\":\"effect_get\",\"fields\":[{\"name\":\"payload\",\"label\":\"Typed request\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true,\"jsonPayload\":\"payload\"},{\"type\":\"form\",\"label\":\"Authorize file change\",\"op\":\"effect_authorize\",\"fields\":[{\"name\":\"effect\",\"label\":\"Effect ID\",\"type\":\"text\"},{\"name\":\"digest\",\"label\":\"Reviewed proposal digest\",\"type\":\"text\"},{\"name\":\"destructive\",\"label\":\"Authorize destructive scope\",\"type\":\"boolean\"}],\"fixed\":{},\"showResult\":true},{\"type\":\"form\",\"label\":\"Apply authorized change\",\"op\":\"effect_apply\",\"fields\":[{\"name\":\"effect\",\"label\":\"Effect ID\",\"type\":\"text\"},{\"name\":\"grant\",\"label\":\"Grant ID\",\"type\":\"text\"}],\"fixed\":{},\"showResult\":true},{\"type\":\"form\",\"label\":\"Revoke unused grant\",\"op\":\"effect_revoke\",\"fields\":[{\"name\":\"grant\",\"label\":\"Grant ID\",\"type\":\"text\"}],\"fixed\":{},\"showResult\":true}]},{\"type\":\"fold\",\"label\":\"Git operations\",\"items\":[{\"type\":\"data\",\"label\":\"Recent Git proposals\",\"value\":\"$1\"},{\"type\":\"form\",\"label\":\"Propose Git change\",\"op\":\"git_propose\",\"fields\":[{\"name\":\"payload\",\"label\":\"Typed request\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true,\"jsonPayload\":\"payload\"},{\"type\":\"form\",\"label\":\"Inspect Git change\",\"op\":\"git_get\",\"fields\":[{\"name\":\"payload\",\"label\":\"Typed request\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true,\"jsonPayload\":\"payload\"},{\"type\":\"form\",\"label\":\"Authorize Git change\",\"op\":\"git_authorize\",\"fields\":[{\"name\":\"mutation\",\"label\":\"Mutation ID\",\"type\":\"text\"},{\"name\":\"digest\",\"label\":\"Reviewed proposal digest\",\"type\":\"text\"},{\"name\":\"destructive\",\"label\":\"Authorize destructive scope\",\"type\":\"boolean\"}],\"fixed\":{},\"showResult\":true},{\"type\":\"form\",\"label\":\"Apply Git change\",\"op\":\"git_apply\",\"fields\":[{\"name\":\"payload\",\"label\":\"Typed request\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true,\"jsonPayload\":\"payload\"},{\"type\":\"form\",\"label\":\"Manage remote branch grants\",\"op\":\"remote\",\"fields\":[{\"name\":\"payload\",\"label\":\"Typed request\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true,\"jsonPayload\":\"payload\"},{\"type\":\"form\",\"label\":\"Install a fetched skill\",\"op\":\"skill\",\"fields\":[{\"name\":\"payload\",\"label\":\"Typed request\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true,\"jsonPayload\":\"payload\"}]},{\"type\":\"fold\",\"label\":\"Connectors and schedules\",\"items\":[{\"type\":\"form\",\"label\":\"Manage connector\",\"op\":\"connector\",\"fields\":[{\"name\":\"payload\",\"label\":\"Typed request\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true,\"jsonPayload\":\"payload\"},{\"type\":\"data\",\"label\":\"Schedules\",\"value\":\"$2\"},{\"type\":\"form\",\"label\":\"Manage schedule\",\"op\":\"schedule\",\"fields\":[{\"name\":\"payload\",\"label\":\"Typed request\",\"type\":\"json\"}],\"fixed\":{},\"showResult\":true,\"jsonPayload\":\"payload\"}]}]}" call append 2 call append 2 call append 2 call arr 0 fsrows gitrows schedules
