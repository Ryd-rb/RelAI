fluxr 1

fn dictionary_panel 1 pid uint uint do 0  1
  ret call shape 2 call str 1 utf8 "{\"type\":\"group\",\"label\":\"Dictionaries and skills\",\"items\":[{\"type\":\"data\",\"label\":\"Dictionary links\",\"value\":\"$0\"},{\"type\":\"data\",\"label\":\"Installed skills\",\"value\":\"$1\"},{\"type\":\"form\",\"label\":\"Create dictionary\",\"op\":\"dictionary\",\"fields\":[{\"name\":\"name\",\"label\":\"Name\",\"type\":\"text\"}],\"fixed\":{\"op\":\"create\"},\"showResult\":true},{\"type\":\"form\",\"label\":\"Change link\",\"op\":\"dictionary\",\"fields\":[{\"name\":\"dictionary\",\"label\":\"Dictionary ID\",\"type\":\"text\"},{\"name\":\"op\",\"label\":\"Change\",\"type\":\"select\",\"choices\":[\"link\",\"unlink\"]}],\"fixed\":{},\"showResult\":true},{\"type\":\"form\",\"label\":\"Edit definition\",\"op\":\"dictionary\",\"fields\":[{\"name\":\"dictionary\",\"label\":\"Owner dictionary ID\",\"type\":\"text\"},{\"name\":\"name\",\"label\":\"Name\",\"type\":\"text\"},{\"name\":\"kind\",\"label\":\"Type\",\"type\":\"select\",\"choices\":[\"knowledge\",\"tool\",\"skill\"]},{\"name\":\"definition\",\"label\":\"Definition\",\"type\":\"textarea\"}],\"fixed\":{\"op\":\"save\"},\"showResult\":true},{\"type\":\"form\",\"label\":\"Install skill\",\"op\":\"skill\",\"fields\":[{\"name\":\"path\",\"label\":\"Package folder or ZIP\",\"type\":\"text\"}],\"fixed\":{\"op\":\"install\"},\"showResult\":true},{\"type\":\"form\",\"label\":\"Remove skill\",\"op\":\"skill\",\"fields\":[{\"name\":\"id\",\"label\":\"Installed version ID\",\"type\":\"text\"}],\"fixed\":{\"op\":\"remove\"},\"showResult\":true}]}" call append 2 call append 2 call arr 0 call dictionary 1 call shape 2 call str 1 utf8 "{\"project\":\"$0\",\"op\":\"list\"}" call append 2 call arr 0 pid call skill 1 call shape 2 call str 1 utf8 "{\"project\":\"$0\",\"op\":\"list\"}" call append 2 call arr 0 pid

fn skill_composer 2 formval uint pid uint uint do 5 items uint names uint fieldval uint rowsval uint i int 8
  set rowsval call query 2 call str 1 utf8 "SELECT id,name FROM skills WHERE project=? AND active=1 ORDER BY name" call append 2 call arr 0 pid
  if eq 0 call size 1 rowsval 1
    ret formval
  0
  set names call arr 0
  set i 0
  while lt i call size 1 rowsval 2
    set names call append 2 names call shape 2 call str 1 utf8 "{\"value\":\"$0\",\"label\":\"$1\"}" call append 2 call append 2 call arr 0 call key 2 call nth 2 rowsval i call str 1 utf8 "id" call key 2 call nth 2 rowsval i call str 1 utf8 "name"
    next i
  set fieldval call shape 2 call str 1 utf8 "{\"name\":\"skills\",\"label\":\"Allow skills for this submission\",\"type\":\"multi\",\"choices\":\"$0\"}" call append 2 call arr 0 names
  set items call append 2 call key 2 formval call str 1 utf8 "fields" fieldval
  ret call put 3 formval call str 1 utf8 "fields" items
