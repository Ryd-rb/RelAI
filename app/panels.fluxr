fluxr 1

fn dictionary_panel 1 pid uint uint do 3 choices uint dictionaries uint skills uint 4
  set dictionaries call dictionary 1 call shape 2 call str 1 @text r#"{"project":"$0","op":"list"}"# call append 2 call arr 0 pid
  set skills call skill 1 call shape 2 call str 1 @text r#"{"project":"$0","op":"list"}"# call append 2 call arr 0 pid
  set choices call nth 2 call query 2 call asset 1 call str 1 utf8 "workspace_management.sql" @build append 1 2 call arr 0 pid call query 2 call asset 1 call str 1 utf8 "project_labels.sql" call arr 0 0
  ret call shape 2 call asset 1 call str 1 utf8 "dictionary_workspace.json" @build append 1 5 call arr 0 dictionaries skills call key 2 choices call str 1 utf8 "available" call key 2 choices call str 1 utf8 "owned" call key 2 choices call str 1 utf8 "installed"

fn model_panel 2 arg uint pid uint uint do 15 assignments uint row uint profile uint titleval uint i int rolesval uint choices uint current uint presetval uint sourceval uint formval uint overview uint fields uint discard uint scopeval uint 19
  set rolesval call resource 1 call str 1 utf8 "roles.json"
  set current call ui_default 2 call key 2 arg call str 1 utf8 "modelRole" call str 1 utf8 "discriminator"
  set discard call require 2 not call same 2 call key 2 rolesval current 0u call str 1 utf8 "Unknown model role"
  set choices call query 2 call str 1 utf8 "SELECT key AS value,upper(substr(key,1,1))||replace(substr(key,2),'_',' ') AS label FROM json_each(?)" call append 2 call arr 0 rolesval
  set assignments call arr 0
  set i 0
  while lt i call size 1 choices 5
    set row call nth 2 choices i
    set profile call preset 2 pid call key 2 row call str 1 utf8 "value"
    set titleval call cat 2 call cat 2 call key 2 row call str 1 utf8 "label" call str 1 utf8 "   ·   " call cat 2 call cat 2 call key 2 profile call str 1 utf8 "model" call str 1 utf8 " · effort: " call key 2 profile call str 1 utf8 "effort"
    set assignments call append 2 assignments call put 3 row call str 1 utf8 "label" titleval
    next i
  set presetval call preset 2 pid current
  set sourceval call str 1 utf8 "Project preset"
  if call same 2 call key 2 presetval call str 1 utf8 "scope" call str 1 utf8 "global" 1
    set sourceval call str 1 utf8 "Global preset"
  0
  if call same 2 call key 2 presetval call str 1 utf8 "scope" call str 1 utf8 "default" 1
    set sourceval call str 1 utf8 "Built-in preset"
  0
  set overview call shape 2 call str 1 @text r#"{
  "type": "preset",
  "choices": "$0",
  "value": "$1",
  "model": "$2",
  "source": "$3",
  "provider": "$4",
  "effort": "$5",
  "section": "active-model"
}"# call append 2 call append 2 call append 2 call append 2 call append 2 call append 2 call arr 0 choices current call key 2 presetval call str 1 utf8 "model" sourceval call key 2 call decode 1 call str 1 utf8 "{\"codex\":\"Codex\",\"anthropic\":\"Anthropic\",\"qwen\":\"Self-hosted Qwen\"}" call key 2 presetval call str 1 utf8 "provider" call key 2 presetval call str 1 utf8 "effort"
  set overview call put 3 overview call str 1 utf8 "assignments" assignments
  set scopeval call ui_default 2 call key 2 arg call str 1 utf8 "modelScope" call str 1 utf8 "project"
  set discard call require 2 or call same 2 scopeval call str 1 utf8 "project" call same 2 scopeval call str 1 utf8 "global" call str 1 utf8 "Unknown model scope"
  if call same 2 scopeval call str 1 utf8 "global" 1
    set presetval call preset 2 call str 1 utf8 "global" current
  0
  set fields call shape 2 call str 1 utf8 "[{\"name\":\"provider\",\"label\":\"Provider\",\"type\":\"select\",\"initial\":\"$0\",\"choices\":[{\"value\":\"codex\",\"label\":\"Codex\"},{\"value\":\"anthropic\",\"label\":\"Anthropic\"},{\"value\":\"qwen\",\"label\":\"Self-hosted Qwen\"}]},{\"name\":\"model\",\"label\":\"Model ID\",\"type\":\"text\",\"required\":true,\"initial\":\"$1\"},{\"name\":\"effort\",\"label\":\"Reasoning effort\",\"type\":\"select\",\"initial\":\"$2\",\"choices\":[{\"value\":\"low\",\"label\":\"Low\"},{\"value\":\"medium\",\"label\":\"Medium\"},{\"value\":\"high\",\"label\":\"High\"}]},{\"name\":\"scope\",\"label\":\"Apply to\",\"type\":\"select\",\"initial\":\"$3\",\"event\":{\"action\":\"path\",\"patch\":{\"view\":\"models\",\"project\":\"$4\"},\"key\":\"modelScope\"},\"choices\":[{\"value\":\"project\",\"label\":\"This project\"},{\"value\":\"global\",\"label\":\"All projects\"}]},{\"name\":\"operation\",\"label\":\"When saved\",\"type\":\"select\",\"choices\":[{\"value\":\"save\",\"label\":\"Use these settings\"},{\"value\":\"reset\",\"label\":\"Restore inherited settings\"}]}]" @build append 1 5 call arr 0 call key 2 presetval call str 1 utf8 "provider" call key 2 presetval call str 1 utf8 "model" call key 2 presetval call str 1 utf8 "effort" scopeval pid
  set formval call shape 2 call str 1 @text r#"{
  "type": "form",
  "label": "Save preset",
  "op": "save_model",
  "fields": "$0",
  "fixed": {
    "role": "$1",
    "scope": "$2"
  },
  "pane": "Configuration",
  "section": "model-settings"
}"# @build append 1 3 call arr 0 fields current scopeval
  ret call shape 2 call str 1 utf8 "{\"type\":\"group\",\"items\":\"$0\"}" call append 2 call arr 0 call append 2 call append 2 call arr 0 overview call ui_merge 2 formval call decode 1 call str 1 @text r#"{"text":"Saved settings apply to subsequently sealed turns. They do not change the model, provider or reasoning effort of a turn whose input is already sealed."}"#

fn skill_composer 2 formval uint pid uint uint do 5 items uint names uint fieldval uint rowsval uint i int 9
  set formval call put 3 formval call str 1 utf8 "completion" call decode 1 call str 1 utf8 "{\"field\":\"text\",\"action\":\"suggest_terms\",\"markers\":\"markers\"}"
  set rowsval call query 2 call str 1 utf8 "SELECT id,CASE WHEN count(*) OVER (PARTITION BY name)>1 THEN name||' ('||substr(digest,1,12)||')' ELSE name END AS label FROM skills WHERE project=? AND active=1 ORDER BY name,digest,id" call append 2 call arr 0 pid
  if eq 0 call size 1 rowsval 1
    ret formval
  0
  set names call arr 0
  set i 0
  while lt i call size 1 rowsval 2
    set names call append 2 names call shape 2 call str 1 utf8 "{\"value\":\"$0\",\"label\":\"$1\"}" call append 2 call append 2 call arr 0 call key 2 call nth 2 rowsval i call str 1 utf8 "id" call key 2 call nth 2 rowsval i call str 1 utf8 "label"
    next i
  set fieldval call shape 2 call str 1 utf8 "{\"name\":\"skills\",\"label\":\"Allow skills for this submission\",\"type\":\"multi\",\"choices\":\"$0\"}" call append 2 call arr 0 names
  set items call append 2 call key 2 formval call str 1 utf8 "fields" fieldval
  ret call put 3 formval call str 1 utf8 "fields" items
