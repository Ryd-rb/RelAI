fluxr 1

fn index_passages 2 pid uint sid uint uint do 5 rowsval uint row uint content uint discard uint i int 4
  set rowsval call query 2 call str 1 utf8 "SELECT DISTINCT b.digest FROM inventory i JOIN blobs b ON b.digest=i.digest AND b.project=? WHERE i.snapshot=? AND i.kind='file' AND i.bytes<=65536 AND NOT EXISTS(SELECT 1 FROM passage_sources_v2 s WHERE s.project=b.project AND s.digest=b.digest) ORDER BY b.digest LIMIT 128" call append 2 call append 2 call arr 0 pid sid
  set i 0
  while lt i call size 1 rowsval 5
    set row call key 2 call nth 2 rowsval i call str 1 utf8 "digest"
    set content call key 2 call baseinfo 1 call key 2 call nth 2 call query 2 call str 1 utf8 "SELECT content FROM blobs WHERE project=? AND digest=?" call append 2 call append 2 call arr 0 pid row 0 call str 1 utf8 "content" call str 1 utf8 "text"
    if not call same 2 content 0u 1
    set discard call query 2 call str 1 utf8 "WITH RECURSIVE source(body,dense) AS (SELECT ?3,length(CAST(?3 AS BLOB))-length(CAST(replace(?3,char(10),'') AS BLOB))>1918), chunks(start,part,remainder,take) AS (SELECT 0,'',body,CASE WHEN NOT dense AND instr(substr(body,1,512),char(10))>0 THEN instr(substr(body,1,512),char(10)) ELSE 512 END FROM source UNION ALL SELECT start+length(CAST(part AS BLOB)),substr(remainder,1,take),substr(remainder,take+1),CASE WHEN NOT dense AND instr(substr(remainder,take+1,512),char(10))>0 THEN instr(substr(remainder,take+1,512),char(10)) ELSE 512 END FROM chunks CROSS JOIN source WHERE length(remainder)>0 LIMIT 2049) INSERT OR IGNORE INTO passages_v2 SELECT ?1,?2,start,start+length(CAST(part AS BLOB)),part FROM chunks WHERE length(part)>0" call append 2 call append 2 call append 2 call arr 0 pid row content
  0
    set discard call query 2 call str 1 utf8 "INSERT OR IGNORE INTO passage_sources_v2 VALUES(?,?)" call append 2 call append 2 call arr 0 pid row
    next i
  ret 0u

fn passage_coverage 2 pid uint sid uint uint do 0 1
  ret call nth 2 call query 2 call str 1 utf8 "WITH eligible AS (SELECT DISTINCT b.digest FROM inventory i JOIN blobs b ON b.digest=i.digest AND b.project=?1 WHERE i.snapshot=?2 AND i.kind='file' AND i.bytes<=65536), counts AS (SELECT count(*) AS eligible,count(s.digest) AS processed FROM eligible e LEFT JOIN passage_sources_v2 s ON s.project=?1 AND s.digest=e.digest) SELECT eligible,processed,eligible-processed AS remaining,CASE WHEN eligible>processed THEN 'true' ELSE 'false' END AS \"partial:json\",'Processed can include skipped nontext sources. Another request continues indexing.' AS note FROM counts" call append 2 call append 2 call arr 0 pid sid 0

fn ranked_passages 4 pid uint sid uint terms uint querytext uint uint do 0 1
  ret call query 2 call str 1 utf8 "WITH names(name) AS (SELECT json_extract(value,'$.ref.name') FROM json_each(?3) UNION SELECT ?4), matches AS (SELECT i.path,p.digest,p.start,p.end,p.body,count(DISTINCT name) AS rank FROM inventory i JOIN passages_v2 p ON p.project=?1 AND p.digest=i.digest JOIN names ON length(name)>0 AND instr(unicode_fold(p.body),unicode_fold(name))>0 WHERE i.snapshot=?2 GROUP BY i.path,p.start ORDER BY rank DESC,i.path,p.start LIMIT 64) SELECT ?2 AS snapshot,* FROM matches ORDER BY rank DESC,path,start" call append 2 call append 2 call append 2 call append 2 call arr 0 pid sid terms querytext
