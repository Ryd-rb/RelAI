fluxr 1

pub hold 1 arg uint uint do 2 j uint discard uint 6
  set j call nth 2 call query 2 call str 1 utf8 "SELECT project,request,state,attempt FROM jobs WHERE id=?" call append 2 call arr 0 call key 2 arg call str 1 utf8 "job" 0
  set discard call query 2 call str 1 utf8 "UPDATE attempts SET state=CASE WHEN ?2 THEN 'rejected' ELSE 'uncertain' END,ended=unixepoch() WHERE id=?1 AND state='sending'" call append 2 call append 2 call arr 0 call key 2 arg call str 1 utf8 "attempt" call key 2 arg call str 1 utf8 "body_received"
  if call same 2 call key 2 j call str 1 utf8 "state" call str 1 utf8 "superseded" 1
    ret 0u
  0
  set discard call query 2 call str 1 utf8 "UPDATE jobs SET state='held',reason=? WHERE id=? AND state IN ('running','sealing','sealed')" call append 2 call append 2 call arr 0 call key 2 arg call str 1 utf8 "error" call key 2 arg call str 1 utf8 "job"
  set discard call audit 3 call key 2 j call str 1 utf8 "project" call str 1 utf8 "Job held" call put 3 arg call str 1 utf8 "request" call key 2 j call str 1 utf8 "request"
  ret 0u

pub poll 1 arg uint uint do 9 files uint f uint j uint jid uint attempt uint count uint discard uint finalrow uint i int 23
  set discard call query 2 call str 1 utf8 "UPDATE jobs SET state='queued',reason=NULL WHERE state='waiting' AND revision=(SELECT revision FROM requests r WHERE r.id=jobs.request AND r.state='open') AND NOT EXISTS(SELECT 1 FROM current_prerequisites c WHERE c.job=jobs.id AND c.satisfied=0)" call arr 0
  set files call query 2 call str 1 @text r#"
    SELECT f.path,f.content,f.digest FROM files f
    WHERE f.verified=0 AND NOT EXISTS (
      SELECT 1 FROM publication_failures p WHERE p.path=f.path AND p.digest=f.digest
        AND p.retry_at>unixepoch())
    ORDER BY f.rowid LIMIT 32
  "# call arr 0
  set i 0
  while lt i call size 1 files 3
    set f call nth 2 files i
    set discard call save_retained 3 call key 2 f call str 1 utf8 "path" call key 2 f call str 1 utf8 "content" call key 2 f call str 1 utf8 "digest"
    next i
  set finalrow call nth 2 call query 2 call str 1 utf8 "SELECT f.request,r.project,a.payload AS \"result:json\",i.job FROM finals f JOIN files d ON d.path=f.path AND d.verified=1 JOIN requests r ON r.id=f.request JOIN actions a ON a.id=f.action JOIN improvements i ON i.request=r.id WHERE f.released=0 LIMIT 1" call arr 0 0
  if not call same 2 finalrow 0u 3
    set discard call audit 3 call key 2 finalrow call str 1 utf8 "project" call str 1 utf8 "Final result" finalrow
    set discard call query 2 call str 1 utf8 "UPDATE finals SET released=1 WHERE request=?" call append 2 call arr 0 call key 2 finalrow call str 1 utf8 "request"
    set discard call query 2 call str 1 utf8 "UPDATE jobs SET state='queued' WHERE id=?" call append 2 call arr 0 call key 2 finalrow call str 1 utf8 "job"
  0
  set j call nth 2 call query 2 call str 1 utf8 "SELECT j.id,j.project,j.request,j.state,j.role,j.kind,j.seal AS \"sealed:json\" FROM jobs j JOIN requests r ON r.id=j.request AND r.revision=j.revision WHERE j.state IN ('queued','sealed') AND (r.state='open' OR (r.state='completed' AND j.role='workflow_improver')) AND NOT EXISTS(SELECT 1 FROM jobs b WHERE b.session=j.session AND b.state IN ('running','sealing','executing')) AND NOT EXISTS(SELECT 1 FROM jobs b WHERE j.role='workflow_improver' AND b.project=j.project AND b.role=j.role AND b.state='running') ORDER BY j.role='workflow_improver',j.role!='discriminator',j.rowid LIMIT 1" call arr 0 0
  if call same 2 j 0u 1
    ret call due_occurrence 0
  0
  if not call current_review 1 j 2
    set discard call query 2 call str 1 utf8 "UPDATE jobs SET state='superseded',reason='Branch state changed before review' WHERE id=?" call append 2 call arr 0 call key 2 j call str 1 utf8 "id"
    ret call review_ready 1 call key 2 j call str 1 utf8 "request"
  0
  if call same 2 call key 2 j call str 1 utf8 "kind" call str 1 utf8 "tool" 1 ret call claim_tool 1 j 0
  set jid call key 2 j call str 1 utf8 "id"
  if call same 2 call key 2 j call str 1 utf8 "state" call str 1 utf8 "queued" 2
    set discard call query 2 call str 1 utf8 "UPDATE jobs SET state='sealing' WHERE id=?" call append 2 call arr 0 jid
    ret call shape 2 call str 1 utf8 "{\"local\":\"seal\",\"job\":\"$0\"}" call append 2 call arr 0 jid
  0
  set count call key 2 call nth 2 call query 2 call str 1 utf8 "SELECT count(*) AS n FROM attempts WHERE job=?" call append 2 call arr 0 jid 0 call str 1 utf8 "n"
  if le 3 call number 1 count 1
    ret call hold 1 call shape 2 call str 1 utf8 "{\"job\":\"$0\",\"error\":\"Attempt limit reached\"}" call append 2 call arr 0 jid
  0
  set count call key 2 call nth 2 call query 2 call str 1 utf8 "SELECT count(*) AS n FROM attempts a JOIN jobs j ON j.id=a.job WHERE j.request=?" call append 2 call arr 0 call key 2 j call str 1 utf8 "request" 0 call str 1 utf8 "n"
  if le 64 call number 1 count 1
    ret call hold 1 call shape 2 call str 1 utf8 "{\"job\":\"$0\",\"error\":\"Request call limit reached\"}" call append 2 call arr 0 jid
  0
  if not call seal_current 1 j 1 ret call hold 1 call shape 2 call str 1 utf8 "{\"job\":\"$0\",\"error\":\"Sealed input access changed. Replace this turn.\"}" call append 2 call arr 0 jid 0
  if not call verify_delivery 1 j 1
    ret call hold 1 call shape 2 call str 1 utf8 "{\"job\":\"$0\",\"error\":\"Required retained document could not be saved\"}" call append 2 call arr 0 jid
  0
  set attempt call uid 0
  set discard call query 2 call str 1 utf8 "INSERT INTO attempts(id,job,state) VALUES(?,?,'sending')" call append 2 call append 2 call arr 0 attempt jid
  set discard call query 2 call str 1 utf8 "UPDATE jobs SET state='running',attempt=? WHERE id=?" call append 2 call append 2 call arr 0 attempt jid
  set discard call audit 3 call key 2 j call str 1 utf8 "project" call str 1 utf8 "Attempt started" call shape 2 call str 1 utf8 "{\"job\":\"$0\",\"request\":\"$1\",\"role\":\"$2\",\"attempt\":\"$3\",\"preset\":\"$4\"}" call append 2 call append 2 call append 2 call append 2 call append 2 call arr 0 jid call key 2 j call str 1 utf8 "request" call key 2 j call str 1 utf8 "role" attempt call key 2 call key 2 j call str 1 utf8 "sealed" call str 1 utf8 "preset"
  ret call shape 2 call str 1 utf8 "{\"job\":\"$0\",\"attempt\":\"$1\",\"transport\":\"$2\"}" call append 2 call append 2 call append 2 call arr 0 jid attempt call key 2 call key 2 j call str 1 utf8 "sealed" call str 1 utf8 "transport"
