    ret receipt
  0
  set discard call query 2 call str 1 utf8 "UPDATE git_transfers SET state=?,receipt=? WHERE id=? AND project=? AND state='sending'" call append 2 call append 2 call append 2 call append 2 call arr 0 kind receipt call key 2 st call str 1 utf8 "operation" call key 2 st call str 1 utf8 "project"
