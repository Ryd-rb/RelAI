  set discard call schedule_read_args 2 toolname action
  set sid call uid 0
  set discard call query 2 call str 1 utf8 "INSERT INTO schedules VALUES(?,?,1,?,?,?,'active')" call append 2 call append 2 call append 2 call append 2 call append 2 call arr 0 sid pid due period action
  set discard call audit 3 pid call str 1 utf8 "Schedule created" call shape 2 call str 1 utf8 "{\"id\":\"$0\",\"due\":\"$1\",\"period\":\"$2\",\"timezone\":\"UTC\",\"action\":\"$3\"}" call append 2 call append 2 call append 2 call append 2 call arr 0 sid due period action
  ret call shape 2 call str 1 utf8 "{\"id\":\"$0\",\"revision\":1}" call append 2 call arr 0 sid

fn schedule_read_args 2 name uint action uint uint do 6 args uint discard uint path uint absolute uint selection uint limitval uint 15
