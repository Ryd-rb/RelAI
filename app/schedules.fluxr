      set discard call require 2 and le 1 call number 1 limitval le call number 1 limitval 256 call str 1 utf8 "Choose a Git history limit between 1 and 256"
    0
  0
  if call same 2 name call str 1 utf8 "project.lookup" 1
    set discard call require 2 call nonblank 1 call key 2 args call str 1 utf8 "request" call str 1 utf8 "Supply a request ID in request"
  0
  if call same 2 name call str 1 utf8 "job.status" 1
    set discard call require 2 call nonblank 1 call key 2 args call str 1 utf8 "id" call str 1 utf8 "Supply a job ID in id"
  0
  if call same 2 name call str 1 utf8 "skill.find" 1
    set discard call check 2 call decode 1 call str 1 @text r#"{"type":"object","properties":{"query":{"type":"string"},"active":{"type":"boolean"}}}"# args
  0
