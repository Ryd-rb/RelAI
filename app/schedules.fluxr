    set discard call check 2 call decode 1 call str 1 @text r#"{"type":"object","required":["query"],"properties":{"query":{"type":"string","minLength":1},"mode":{"enum":[null,"literal","regex"]}}}"# args
    set discard call require 2 le call size 1 call key 2 args call str 1 utf8 "query" 256 call str 1 utf8 "Expected a search query of at most 256 bytes"
    set discard call require 2 call same 2 call key 2 args call str 1 utf8 "range" 0u call str 1 utf8 "Scheduled search uses the full file"
  0
