fn due_occurrence 0  uint do 5 row uint idval uint atval uint rev uint discard uint 10
  set row call nth 2 call query 2 call str 1 utf8 "SELECT o.schedule AS id,s.project,o.revision,o.instant AS due FROM occurrences o JOIN schedules s ON o.schedule=s.id AND o.revision=s.revision WHERE o.state='ready' AND s.state IN ('active','dispatched') ORDER BY o.instant,o.schedule LIMIT 1" call arr 0 0
