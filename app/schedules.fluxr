    ret call audit 3 pid call str 1 utf8 "Schedule cancelled" call shape 2 call str 1 utf8 "{\"schedule\":\"$0\"}" call append 2 call arr 0 sid
  0
  set discard call require 2 call same 2 op call str 1 utf8 "create" call str 1 utf8 "Unknown schedule operation"
  set due call key 2 arg call str 1 utf8 "due"
  set period call key 2 arg call str 1 utf8 "period"
  set discard call require 2 and le 0 call number 1 due le 0 call number 1 period call str 1 utf8 "Invalid planned instant or interval"
  set discard call require 2 or eq 0 call number 1 period le 1 call number 1 period call str 1 utf8 "Invalid interval"
