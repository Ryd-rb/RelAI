  set discard call require 2 call same 2 call query 2 call str 1 utf8 "UPDATE reproduction_reviews SET state='completed',phase=NULL,receipt=? WHERE id=? AND project=? AND digest=? AND state='running' AND phase='correction' AND approved_at IS NOT NULL" @build append 1 4 call arr 0 call encode 1 receipt rid pid digest call integer 1 1 call str 1 utf8 "Review is not awaiting correction completion"
