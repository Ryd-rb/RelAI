    set discard call query 2 call str 1 @text r#"INSERT INTO owner_reproduction_evidence(review,project,candidate,baseline_test,correction_test) SELECT r.id,r.project,r.review->>'$.candidate',old.id,new.id FROM reproduction_reviews r JOIN tool_tests old ON old.id=?4 AND old.project=r.project JOIN tool_tests new ON new.id=?5 AND new.project=r.project WHERE r.id=?1 AND r.project=?2 AND r.digest=?3 AND r.state='running' AND r.phase='correction' AND r.approved_at IS NOT NULL AND old.id=r.baseline_receipt->>'$.id' AND old.version=r.review->>'$.scope.baseline' AND new.version=r.review->>'$.scope.correction' AND old.request=new.request AND old.request=?6 AND old.outcome='failed' AND new.outcome='passed'"# @build append 1 6 call arr 0 rid pid digest oldid newid call encode 1 call key 2 review call str 1 utf8 "case"
