    ret call key 2 row call str 1 utf8 "receipt"
  0
  set review call key 2 row call str 1 utf8 "review"
  set discard call require 2 call same 2 call query 2 call str 1 utf8 "UPDATE reproduction_reviews SET state='running',phase='baseline',approved_at=unixepoch() WHERE id=? AND project=? AND digest=? AND state='planned'" @build append 1 3 call arr 0 rid pid digest call integer 1 1 call str 1 utf8 "This review is already running. Prepare a fresh review if the previous run was interrupted."
  ret call reproduction_start 3 review digest call str 1 utf8 "baseline"

