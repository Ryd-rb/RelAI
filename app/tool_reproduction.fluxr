  0
  set receipt call shape 2 call str 1 @text r#"{"id":"$0","version":"$1","case":"$2","observed":"$3","outcome":"$4","error":"$5","execution":"$6","provisional":true}"# @build append 1 7 call arr 0 tid version case observed outcome errorval resultval
  set discard call query 2 call str 1 utf8 "INSERT INTO tool_tests(id,project,version,request,expected,observed,outcome,receipt) VALUES(?,?,?,?,?,?,?,?)" @build append 1 8 call arr 0 tid pid version call encode 1 case call encode 1 call key 2 case call str 1 utf8 "expected" observed outcome call encode 1 receipt
  ret receipt

fn reproduction_finish 4 review uint digest uint baseline uint correction uint uint do 8 pid uint rid uint discard uint receipt uint reproduced bool resultval uint oldid uint newid uint 10
