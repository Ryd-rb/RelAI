pub tool_reproduce 1 arg uint uint do 6 pid uint rid uint digest uint row uint review uint discard uint 9
  set discard call check 2 call decode 1 call str 1 @text r#"{"type":"object","additionalProperties":false,"required":["project","review","digest"],"properties":{"project":{"type":"string"},"review":{"type":"string"},"digest":{"type":"string"}}}"# arg
  set pid call key 2 call project 1 arg call str 1 utf8 "id"
