fn reproduction_row 3 pid uint rid uint digest uint uint do 3 row uint review uint discard uint 5
  set row call nth 2 call query 2 call str 1 @text r#"SELECT state,phase,approved_at,review AS "review:json",baseline_receipt AS "baseline_receipt:json",receipt AS "receipt:json" FROM reproduction_reviews WHERE project=? AND id=? AND digest=?"# @build append 1 3 call arr 0 pid rid digest 0
