{
  "type": "group",
  "items": [
    {
      "type": "form",
      "label": "Find tools",
      "op": "tool_run",
      "presentation": "search",
      "fields": [
        {
          "name": "query",
          "label": "Search tools",
          "type": "text"
        }
      ],
      "fixed": {
        "tool": "tool.find"
      },
      "showResult": true,
      "pane": "Library",
      "section": "tool-search"
    },
    {
      "type": "fold",
      "label": "Run a tool",
      "foldKey": "run-tools",
      "items": [
        {
          "type": "form",
          "label": "Run tool",
          "op": "tool_run",
          "fields": [
            {
              "name": "tool",
              "label": "Tool ID",
              "type": "text"
            },
            {
              "name": "arguments",
              "label": "Arguments",
              "type": "json"
            }
          ],
          "fixed": {},
          "showResult": true
        },
        {
          "type": "form",
          "label": "Run an exact registered version",
          "op": "tool_run",
          "fields": [
            {
              "name": "tool",
              "label": "Tool name",
              "type": "text"
            },
            {
              "name": "version",
              "label": "Version digest",
              "type": "text"
            },
            {
              "name": "arguments",
              "label": "Arguments",
              "type": "json"
            }
          ],
          "fixed": {},
          "showResult": true
        }
      ],
      "pane": "Library",
      "section": "tool-run"
    },
    {
      "type": "fold",
      "label": "Propose checked source",
      "foldKey": "tool-versions-0",
      "pane": "Versions",
      "section": "tool-versions",
      "items": [
        {
          "type": "form",
          "label": "Propose checked source",
          "op": "tool_propose",
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "type": "text"
            },
            {
              "name": "capability",
              "label": "Capability ID",
              "type": "text"
            },
            {
              "name": "export",
              "label": "Export",
              "type": "text"
            },
            {
              "name": "source",
              "label": "FluxR source",
              "type": "textarea"
            }
          ],
          "fixed": {},
          "showResult": true
        }
      ]
    },
    {
      "type": "fold",
      "label": "Test a draft",
      "foldKey": "tool-versions-1",
      "pane": "Versions",
      "section": "tool-versions",
      "items": [
        {
          "type": "form",
          "label": "Test a draft",
          "op": "tool_test",
          "fields": [
            {
              "name": "version",
              "label": "Version digest",
              "type": "text"
            },
            {
              "name": "case",
              "label": "Test case",
              "type": "json"
            }
          ],
          "fixed": {},
          "showResult": true
        }
      ]
    },
    {
      "type": "fold",
      "label": "Qualify a draft",
      "foldKey": "tool-versions-2",
      "pane": "Versions",
      "section": "tool-versions",
      "items": [
        {
          "type": "form",
          "label": "Qualify a draft",
          "op": "tool_qualify",
          "fields": [
            {
              "name": "version",
              "label": "Version digest",
              "type": "text"
            }
          ],
          "fixed": {},
          "showResult": true
        }
      ]
    },
    {
      "type": "fold",
      "label": "Run reproduction",
      "foldKey": "tool-versions-reproduce",
      "pane": "Versions",
      "section": "tool-versions",
      "items": [
        {
          "type": "form",
          "label": "Run reproduction",
          "op": "tool_reproduce_case",
          "text": "Run one bounded case against the exact baseline and correction versions. RelAI records the case, version digests and both results automatically.",
          "fields": [
            {"name": "candidate", "label": "Deferred candidate ID", "type": "text", "required": true},
            {"name": "case", "label": "Test case", "type": "json", "required": true}
          ],
          "showResult": true
        }
      ]
    },
    {
      "type": "fold",
      "label": "Promote a version",
      "foldKey": "tool-versions-3",
      "pane": "Versions",
      "section": "tool-versions",
      "items": [
        {
          "type": "form",
          "label": "Promote a version",
          "op": "tool_promote",
          "text": "Enter the current default's version digest as the expected default. Leave it blank only if this tool has no existing default.",
          "fields": [
            {"name": "tool", "label": "Tool name", "type": "text", "required": true},
            {"name": "version", "label": "Version digest to promote", "type": "text", "required": true},
            {"name": "expected", "label": "Expected current default digest (optional)", "type": "text"}
          ],
          "fixed": {},
          "showResult": true
        }
      ]
    },
    {
      "type": "fold",
      "label": "Revoke a version",
      "foldKey": "tool-versions-4",
      "pane": "Versions",
      "section": "tool-versions",
      "items": [
        {
          "type": "form",
          "label": "Revoke a version",
          "op": "tool_revoke",
          "fields": [
            {
              "name": "version",
              "label": "Version digest",
              "type": "text"
            }
          ],
          "fixed": {},
          "showResult": true
        }
      ]
    },
    {
      "type": "group",
      "label": "File changes",
      "pane": "Changes",
      "section": "files",
      "items": [
        {
          "type": "fold",
          "label": "Select or revoke a live source",
          "foldKey": "files-0",
          "pane": "Changes",
          "section": "files",
          "items": [
            {
              "type": "form",
              "op": "source_access",
              "label": "Select or revoke a live source",
              "text": "Use the open request ID and a numeric revision. Omit session to use the request's discriminator, or supply a session ID for that request. Allow and revoke require host_path; list does not. Replace the example ID and path with your own.\n\nList: {\"op\":\"list\",\"request\":\"0123456789abcdef0123456789abcdef\",\"revision\":1}\nAllow: {\"op\":\"allow\",\"request\":\"0123456789abcdef0123456789abcdef\",\"revision\":1,\"host_path\":\"C:/work/notes.txt\"}\nRevoke: {\"op\":\"revoke\",\"request\":\"0123456789abcdef0123456789abcdef\",\"revision\":1,\"host_path\":\"C:/work/notes.txt\"}",
              "fields": [
                {
                  "name": "payload",
                  "label": "Request, revision, session, host_path and operation",
                  "type": "json"
                }
              ],
              "jsonPayload": "payload",
              "showResult": true
            }
          ]
        },
        {
          "type": "data",
          "label": "Recent file proposals",
          "value": "$0",
          "pane": "Changes",
          "section": "files"
        },
        {
          "type": "fold",
          "label": "Inspect proposal",
          "foldKey": "files-2",
          "pane": "Changes",
          "section": "files",
          "items": [
            {
              "type": "form",
              "label": "Inspect proposal",
              "op": "effect_get",
              "fields": [
                {
                  "name": "effect",
                  "label": "Effect ID",
                  "type": "text",
                  "required": true
                }
              ],
              "fixed": {},
              "showResult": true
            }
          ]
        },
        {
          "type": "fold",
          "label": "Run file change",
          "foldKey": "files-run",
          "pane": "Changes",
          "section": "files",
          "items": [
            {
              "type": "form",
              "label": "Run file change",
              "op": "apply_file_change",
              "fields": [
                {
                  "name": "payload",
                  "label": "Typed request",
                  "type": "json",
                  "required": true
                }
              ],
              "jsonPayload": "payload",
              "showResult": true
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "label": "Git operations",
      "pane": "Changes",
      "section": "git",
      "items": [
        {
          "type": "data",
          "label": "Recent Git proposals",
          "value": "$1",
          "pane": "Changes",
          "section": "git"
        },
        {
          "type": "fold",
          "label": "Run Git change",
          "foldKey": "git-1",
          "pane": "Changes",
          "section": "git",
          "items": [
            {
              "type": "form",
              "label": "Run Git change",
              "op": "apply_git_change",
              "fields": [
                {
                  "name": "payload",
                  "label": "Typed request",
                  "type": "json",
                  "required": true
                }
              ],
              "fixed": {},
              "showResult": true,
              "jsonPayload": "payload",
              "text": "Run an exact git.stage, git.commit or git.branch request. Include the expected HEAD and index for staging or committing, or the expected branch tip for creation or deletion."
            }
          ]
        },
        {
          "type": "fold",
          "label": "Inspect Git change",
          "foldKey": "git-2",
          "pane": "Changes",
          "section": "git",
          "items": [
            {
              "type": "form",
              "label": "Inspect Git change",
              "op": "git_get",
              "fields": [
                {
                  "name": "payload",
                  "label": "Typed request",
                  "type": "json"
                }
              ],
              "fixed": {},
              "showResult": true,
              "jsonPayload": "payload"
            }
          ]
        },
        {
          "type": "fold",
          "label": "Manage remote branches",
          "foldKey": "git-5",
          "pane": "Changes",
          "section": "git",
          "items": [
            {
              "type": "form",
              "label": "Manage remote branches",
              "op": "remote",
              "text": "Register an HTTPS repository and branch for this project. You can then ask RelAI to push to it in chat.",
              "fields": [
                {
                  "name": "payload",
                  "label": "Typed request",
                  "type": "json"
                }
              ],
              "fixed": {},
              "showResult": true,
              "jsonPayload": "payload"
            }
          ]
        },
        {
          "type": "fold",
          "label": "Retire an uncertain fetch",
          "foldKey": "git-retire-fetch",
          "pane": "Changes",
          "section": "git",
          "items": [
            {
              "type": "form",
              "label": "Retire fetch",
              "op": "remote",
              "text": "Enter the operation ID from the uncertain fetch. RelAI keeps the original receipt and records the retirement locally. The fetch outcome remains unconfirmed.",
              "fields": [
                {
                  "name": "id",
                  "label": "Fetch operation ID",
                  "type": "text",
                  "required": true
                }
              ],
              "fixed": {
                "op": "retire_fetch"
              },
              "showResult": true
            }
          ]
        },
        {
          "type": "fold",
          "label": "Install a fetched skill",
          "foldKey": "git-6",
          "pane": "Changes",
          "section": "git",
          "items": [
            {
              "type": "form",
              "label": "Install a fetched skill",
              "op": "skill",
              "text": "Use the transfer ID from a completed Git fetch and the package directory containing SKILL.md in that fetched tree.",
              "fields": [
                {"name": "transfer", "label": "Completed fetch transfer ID", "type": "text", "required": true},
                {"name": "path", "label": "Package directory in the fetched tree", "type": "text"}
              ],
              "fixed": {
                "op": "install_git"
              },
              "showResult": true
            }
          ]
        }
      ]
    },
    {
      "type": "fold",
      "label": "Manage connector",
      "foldKey": "automation-0",
      "pane": "Automation",
      "section": "automation",
      "items": [
        {
          "type": "form",
          "label": "Manage connector",
          "op": "connector",
          "text": "Register a connector with a fixed destination and argument schema. You can then ask RelAI to send a request to it in chat.",
          "fields": [
            {
              "name": "payload",
              "label": "Typed request",
              "type": "json"
            }
          ],
          "fixed": {},
          "showResult": true,
