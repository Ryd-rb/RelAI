        {
          "name": "query",
          "label": "Search tools",
          "type": "text"
        }
      ],
      "fixed": {
        "tool": "tool.find"
      },
      "showResult": true,
      "pane": "Library",
      "section": "tool-search"
    },
    {
      "type": "fold",
