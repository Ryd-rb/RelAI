            {
              "type": "form",
              "op": "source_access",
              "label": "Select or revoke a live source",
              "text": "Use the open request ID and a numeric revision. Omit session to use the request's discriminator, or supply a session ID for that request. Allow and revoke require host_path; list does not. Replace the example ID and path with your own.\n\nList: {\"op\":\"list\",\"request\":\"0123456789abcdef0123456789abcdef\",\"revision\":1}\nAllow: {\"op\":\"allow\",\"request\":\"0123456789abcdef0123456789abcdef\",\"revision\":1,\"host_path\":\"C:/work/notes.txt\"}\nRevoke: {\"op\":\"revoke\",\"request\":\"0123456789abcdef0123456789abcdef\",\"revision\":1,\"host_path\":\"C:/work/notes.txt\"}",
              "fields": [
                {
                  "name": "payload",
                  "label": "Request, revision, session, host_path and operation",
                  "type": "json"
                }
              ],
              "jsonPayload": "payload",
              "showResult": true
            }
          ]
        },
