      "items": [
        {
          "type": "form",
          "label": "Promote a version",
          "op": "tool_promote",
          "text": "Enter the current default's version digest as the expected default. Leave it blank only if this tool has no existing default.",
          "fields": [
            {"name": "tool", "label": "Tool name", "type": "text", "required": true},
            {"name": "version", "label": "Version digest to promote", "type": "text", "required": true},
            {"name": "expected", "label": "Expected current default digest (optional)", "type": "text"}
          ],
          "fixed": {},
          "showResult": true
        }
      ]
    },
