fluxr 1

pub save_term 1 arg uint uint do 2 p uint discard uint 5
  set p call key 2 call project 1 arg call str 1 utf8 "id"
  set discard call require 2 not call same 2 call nth 2 call query 2 call str 1 utf8 "SELECT 1 FROM dictionary_links l JOIN dictionaries d ON d.id=l.dictionary AND d.archived=0 WHERE l.project=?1 AND l.dictionary=?1 AND l.enabled=1" call append 2 call arr 0 p 0 0u call str 1 utf8 "The destination project dictionary is unlinked or archived. Enable its link before saving a project definition."
  set discard call require 2 and lt 0 call size 1 call key 2 arg call str 1 utf8 "name" lt 0 call size 1 call key 2 arg call str 1 utf8 "definition" call str 1 utf8 "Enter a term and its definition"
  set discard call dictionary 1 call put 3 call put 3 arg call str 1 utf8 "kind" call str 1 utf8 "knowledge" call str 1 utf8 "op" call str 1 utf8 "save"
  ret call query 2 call str 1 utf8 "INSERT INTO terms VALUES(?,?,?,?,1,'knowledge') ON CONFLICT(id) DO UPDATE SET definition=excluded.definition,revision=terms.revision+1" call append 2 call append 2 call append 2 call append 2 call arr 0 call hash 1 call encode 1 call append 2 call append 2 call arr 0 p call key 2 arg call str 1 utf8 "name" p call key 2 arg call str 1 utf8 "name" call key 2 arg call str 1 utf8 "definition"

pub dashboard 1 arg uint uint do 9 projectname uint projects uint p uint pid uint components uint tabs uint row uint viewname uint i int 15
  set projects call query 2 call asset 1 call str 1 utf8 "project_labels.sql" call arr 0
  set pid call key 2 arg call str 1 utf8 "project"
  if call same 2 pid 0u 1
    set pid call key 2 call nth 2 call query 2 call str 1 @text r#"
      SELECT coalesce((SELECT project FROM desktop_selection WHERE singleton=1),
                      (SELECT project FROM submissions ORDER BY rowid DESC LIMIT 1),
                      (SELECT id FROM projects ORDER BY rowid LIMIT 1)) AS id
    "# call arr 0 0 call str 1 utf8 "id"
  0
  set tabs call arr 0
  set i 0
  while lt i call size 1 projects 4
    set row call nth 2 projects i
    if call same 2 call key 2 row call str 1 utf8 "id" pid 1
    set projectname call key 2 row call str 1 utf8 "short"
  0
    set tabs call append 2 tabs call shape 2 call str 1 utf8 "{\"type\":\"button\",\"label\":\"$0\",\"shortLabel\":\"$2\",\"navigate\":{\"project\":\"$1\",\"view\":\"relay\",\"reply\":null,\"steer\":null}}" call append 2 call append 2 call append 2 call arr 0 call key 2 row call str 1 utf8 "root" call key 2 row call str 1 utf8 "id" call key 2 row call str 1 utf8 "short"
    next i
  set tabs call append 2 tabs call shape 2 call str 1 utf8 "{\"type\":\"button\",\"label\":\"Open project\",\"navigate\":{\"view\":\"open\"},\"projectCount\":\"$0\"}" call append 2 call arr 0 call integer 1 call size 1 projects
  set components call append 2 call arr 0 call shape 2 call str 1 @text r#"{
  "type": "nav",
  "label": "Projects",
  "dockable": true,
  "items": "$0"
}"# call append 2 call arr 0 tabs
  set viewname call key 2 arg call str 1 utf8 "view"
  if or call same 2 pid 0u call same 2 viewname call str 1 utf8 "open" 2
    set components call append 2 components call shape 2 call str 1 @text r#"{
  "type": "form",
  "label": "Open project",
  "op": "open_project",
  "fields": [
    {
      "name": "root",
      "label": "Existing project folder",
      "type": "folder",
      "required": true
    }
  ],
  "fixed": {},
  "selectResult": {
    "project": "id"
  },
  "section": "open-project"
}"# call arr 0
    ret call shape 2 call str 1 utf8 "{\"title\":\"RelAI\",\"subtitle\":\"Project relay\",\"components\":\"$0\"}" call append 2 call arr 0 components
  0
  set p call project 1 call shape 2 call str 1 utf8 "{\"project\":\"$0\"}" call append 2 call arr 0 pid
  set components call append 2 components call shape 2 call str 1 @text r#"{
  "type": "nav",
  "label": "Workspace",
  "items": [
    {
      "type": "button",
      "label": "Relay",
      "navigate": {
        "view": "relay"
      }
    },
    {
      "type": "button",
      "label": "Activity",
      "navigate": {
        "view": "activity"
      }
    },
    {
      "type": "button",
      "label": "Project graph",
      "navigate": {
        "view": "graph"
      }
    },
    {
      "type": "button",
      "label": "Tools",
      "navigate": {
        "view": "tools"
      }
    }
  ]
}"# call arr 0
  set components call append 2 components call decode 1 call str 1 @text r#"{"type":"nav","label":"Settings","items":[{"type":"button","label":"Models","navigate":{"view":"models"}},{"type":"button","label":"Dictionary","navigate":{"view":"dictionary"}}]}"#
  if call same 2 viewname call str 1 utf8 "models" 1
    set components call append 2 components call model_panel 2 arg pid
  1
    if call same 2 viewname call str 1 utf8 "graph" 1
    set components call append 2 components call shape 2 call str 1 utf8 "{\"type\":\"group\",\"items\":\"$0\"}" call append 2 call arr 0 call graph_view 2 arg pid
  1
    if call same 2 viewname call str 1 utf8 "file" 1
    set components call append 2 components call shape 2 call str 1 utf8 "{\"type\":\"data\",\"label\":\"$0\",\"value\":\"$1\"}" call append 2 call append 2 call arr 0 call key 2 arg call str 1 utf8 "file" call readtext 2 call key 2 p call str 1 utf8 "root" call key 2 arg call str 1 utf8 "file"
  1
    if call same 2 viewname call str 1 utf8 "dictionary" 3
    set components call append 2 components call dictionary_panel 1 pid
    set components call append 2 components call shape 2 call str 1 @text r#"{
  "type": "lexicon",
  "label": "Project definitions",
  "value": "$0",
  "pane": "Terms",
  "section": "term-library"
}"# call append 2 call arr 0 call query 2 call str 1 utf8 "SELECT name,definition,kind,revision FROM terms WHERE project=? ORDER BY name" call append 2 call arr 0 pid
    set components call append 2 components call shape 2 call str 1 @text r#"{
  "type": "fold",
  "label": "Add a project term",
  "items": [
    {
      "type": "form",
      "label": "Save definition",
      "op": "save_term",
      "fields": [
        {
          "name": "name",
          "label": "Term",
          "type": "text"
        },
        {
          "name": "definition",
          "label": "Definition",
          "type": "textarea"
        }
      ],
      "fixed": {}
    }
  ],
  "pane": "Terms",
  "section": "term-edit"
}"# call arr 0
  1
    if call same 2 viewname call str 1 utf8 "tools" 2
    set p call put 3 p call str 1 utf8 "toolCatalog" call tool_catalog 1 call shape 2 call str 1 @text r#"{"project":"$0"}"# call append 2 call arr 0 pid
    set components call append 2 components call operations_panel 1 pid
  1
    if call same 2 viewname call str 1 utf8 "activity" 1
      set components call append 2 components call activity_panel 0
    1
      set components call chat_panel 3 arg pid components
  ret call shape 2 call str 1 utf8 "{\"title\":\"RelAI\",\"subtitle\":\"$0\",\"project\":\"$1\",\"components\":\"$2\",\"name\":\"$3\",\"toolCatalog\":\"$4\"}" @build append 1 5 call arr 0 call key 2 p call str 1 utf8 "root" pid components projectname call key 2 p call str 1 utf8 "toolCatalog"
